// ======================================================
// 2gether / 유대감 ERD — 개선안 (v2)
// DB: PostgreSQL 15+ / Spring Boot 3.5 + JPA(Hibernate 6)
//
// 개선 요약:
//  - 코드베이스(tags 통합, users 컬럼)와 정합성 일치
//  - gathering_tag(모임 태그) 추가 → 검색/필터 지원
//  - 캠퍼스 비율 기능 제외 → users.campus 미사용(코드와 그대로 일치)
//  - user_hobby_tag/user_skill_tag → 통합 user_tag 로 정리
//  - 파생 상태/집계용 인덱스 및 제약 정비
//  - PostgreSQL native enum 대신 varchar + CHECK (Hibernate 매핑 안정성)
// ======================================================


// ─────────────────────────── Enum (JPA는 varchar + @Enumerated(STRING) 로 매핑)

Enum campus_type {
  HUMANITIES
  NATURAL
}

Enum day_of_week {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Enum availability_repeat_type {
  EVERY_WEEK
  ODD_WEEK
  EVEN_WEEK
}

Enum tag_type {
  HOBBY
  SKILL
}

Enum gathering_category {
  STUDY
  HOBBY
  HACKATHON
  PROJECT
  NETWORKING
}

Enum gathering_status {
  RECRUITING
  CONFIRMED
  COMPLETED
  CANCELED
}

Enum application_status {
  PENDING
  ACCEPTED
  REJECTED
}

Enum gathering_member_role {
  HOST
  MEMBER
}

Enum chat_room_type {
  GROUP
  QUICK_CONNECT
}

Enum message_type {
  TEXT
  IMAGE
  SYSTEM
}

Enum ai_status {
  PENDING
  APPROVED
  REJECTED
}

Enum quick_code_status {
  ACTIVE
  EXPIRED
  USED
}


// ======================================================
// 학교 / 캠퍼스 / 단과대학 / 학과
// ======================================================

Table university {
  id bigint [pk, increment]
  name varchar(60) [not null, unique]
  email_domain varchar(60) [not null, unique, note: '예: mju.ac.kr']
}

Table college {
  id bigint [pk, increment]
  university_id bigint [not null, ref: > university.id]
  campus campus_type [not null]
  name varchar(60) [not null]
  indexes {
    (university_id, campus, name) [unique]
  }
}

Table department {
  id bigint [pk, increment]
  college_id bigint [not null, ref: > college.id]
  name varchar(60) [not null]
  indexes {
    (college_id, name) [unique]
  }
}


// ======================================================
// 사용자 / 인증 / 프로필
// ======================================================

Table users {
  id bigint [pk, increment]
  auth_user_id varchar(120) [not null, unique, note: 'Supabase Auth sub']
  department_id bigint [ref: > department.id, note: '온보딩 이전 NULL 허용']

  real_name varchar(30)
  nickname varchar(30) [unique]
  age smallint
  student_number varchar(15)

  // [변경] 캠퍼스 비율 기능 제외 → users.campus 미사용.
  //        캠퍼스는 department → college.campus 로 유도 가능하므로 별도 저장 안 함.
  //        (현재 코드 User 엔티티에도 campus 컬럼이 없어 그대로 일치)

  preferred_region varchar(150)
  profile_image_url varchar(300)
  introduction varchar(200) [note: '코드 컬럼명 introduction 으로 통일 (구 bio)']

  // [개선] 코드가 boolean 방식이므로 boolean 으로 통일.
  //        인증 이력이 필요하면 email_verification 테이블로 추적.
  school_email varchar(120) [unique, note: '코드 컬럼명 school_email 로 통일']
  email_verified boolean [not null, default: false]
  profile_completed boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (department_id)
  }
}

Table email_verification {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  email varchar(120) [not null]
  verification_code varchar(10) [not null]
  expires_at timestamptz [not null]
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
  }
}


// ======================================================
// 태그 (코드베이스 반영: 단일 tags 테이블 + type)
// ======================================================

Table tags {
  id bigint [pk, increment]
  name varchar(30) [not null]
  type tag_type [not null]
  indexes {
    (type, name) [unique, note: '타입 내 태그명 중복 방지']
    (type)
  }
}

// [개선] user_hobby_tag/user_skill_tag 두 테이블 → user_tag 하나로 통합.
//        tags.type 으로 취미/기술 구분되므로 링크 테이블을 나눌 필요 없음.
//        (현재 코드에 링크 엔티티 자체가 미구현 → 신규 추가 필요)
Table user_tag {
  user_id bigint [not null, ref: > users.id]
  tag_id  bigint [not null, ref: > tags.id]
  indexes {
    (user_id, tag_id) [pk]
    (tag_id) [note: 'AI 추천 시 태그로 사용자 역탐색']
  }
}


// ======================================================
// 사용자 가용 일정
// ======================================================

Table availabilities {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  repeat_type availability_repeat_type [not null, default: 'EVERY_WEEK']
  day_of_week day_of_week [not null]
  start_time time [not null]
  end_time time [not null]
  indexes {
    (user_id, repeat_type, day_of_week, start_time, end_time) [unique]
    (user_id)
  }
}


// ======================================================
// 모임
// ======================================================

Table gathering {
  id bigint [pk, increment]
  host_id bigint [not null, ref: > users.id]
  title varchar(120) [not null]
  content text
  // [개선] varchar → enum 승격 (오타/표기 흔들림 방지, 필터 안정)
  category gathering_category [not null]
  location varchar(150)
  max_members smallint [not null, default: 6, note: 'CHECK max_members >= 1']

  // [개선] 목록 화면 "현재 인원" 매 조회 집계 부담 → 확정 인원 캐시.
  //        gathering_member 증감 시 트랜잭션 내 동기 갱신.
  current_members smallint [not null, default: 1]

  fusion_enabled boolean [not null, default: false]
  status gathering_status [not null, default: 'RECRUITING']
  recruit_start_at timestamptz [note: 'NULL이면 생성 즉시 모집']
  recruit_end_at timestamptz [note: 'NULL이면 상시 모집']
  meet_at timestamptz
  confirmed_at timestamptz
  canceled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, category)
    (recruit_end_at)
    (host_id)
    (created_at)
  }
}

// [개선] 모임 태그 — 커뮤니티 화면의 태그 표시/검색 요구사항 충족(기존 ERD 누락)
Table gathering_tag {
  gathering_id bigint [not null, ref: > gathering.id]
  tag_id bigint [not null, ref: > tags.id]
  indexes {
    (gathering_id, tag_id) [pk]
    (tag_id, gathering_id) [note: '태그로 모임 검색']
  }
}

Table gathering_image {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  image_url varchar(300) [not null]
  sort_order smallint [not null, default: 0]
  indexes {
    (gathering_id, sort_order) [unique]
  }
}

Table gathering_member {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  user_id bigint [not null, ref: > users.id]
  role gathering_member_role [not null, default: 'MEMBER']
  joined_at timestamptz [not null, default: `now()`]
  indexes {
    (gathering_id, user_id) [unique]
    (user_id) [note: '내가 참여한 모임 조회']
  }
}

Table gathering_application {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  user_id bigint [not null, ref: > users.id]
  message varchar(300)
  status application_status [not null, default: 'PENDING']
  reject_reason varchar(200)
  applied_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz
  indexes {
    // [개선] 재신청 정책에 따라 선택.
    //  - 재신청 불가: (gathering_id, user_id) UNIQUE
    //  - REJECTED 후 재신청 허용: PENDING/ACCEPTED 만 부분 유니크
    //    (PostgreSQL) CREATE UNIQUE INDEX ... WHERE status IN ('PENDING','ACCEPTED')
    (gathering_id, user_id) [unique]
    (user_id, status) [note: '내 신청 목록']
    (gathering_id, status) [note: '방장의 신청함']
  }
}


// ======================================================
// AI 추천 / 아이디어
// ======================================================

Table gathering_recommendation {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  gathering_id bigint [not null, ref: > gathering.id]
  round_no int [not null]
  reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, gathering_id, round_no) [unique]
    (user_id, round_no) [note: '회차별 내 추천 조회']
  }
}

Table idea {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  created_gathering_id bigint [ref: - gathering.id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
  }
}

// [개선] idea.recommended_departments(text CSV) → 정규화 링크 테이블.
//        조인/통계 가능. (단순 로그용이면 유지 가능 — 용도 확인 후 결정)
Table idea_recommended_department {
  idea_id bigint [not null, ref: > idea.id]
  department_id bigint [not null, ref: > department.id]
  indexes {
    (idea_id, department_id) [pk]
  }
}


// ======================================================
// 채팅 / 안심 커넥트
// ======================================================

Table chat_room {
  id bigint [pk, increment]
  gathering_id bigint [unique, ref: - gathering.id, note: 'QUICK_CONNECT는 NULL']
  type chat_room_type [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table chat_room_member {
  id bigint [pk, increment]
  chat_room_id bigint [not null, ref: > chat_room.id]
  user_id bigint [not null, ref: > users.id]
  // [개선] 안 읽은 메시지 수 계산용 마지막 읽은 메시지.
  last_read_message_id bigint [note: 'unread 계산 기준']
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz [note: 'NULL이면 참여 중']
  indexes {
    (chat_room_id, user_id) [unique]
    (user_id)
  }
}

Table quick_connect_code {
  id bigint [pk, increment]
  chat_room_id bigint [not null, unique, ref: - chat_room.id]
  created_by bigint [ref: > users.id]
  code char(6) [not null]
  status quick_code_status [not null, default: 'ACTIVE']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    // [개선] 전체 code UNIQUE 는 만료/재사용 코드와 충돌.
    //        활성 코드만 유일하게: 부분 유니크 인덱스 권장.
    //        CREATE UNIQUE INDEX ... (code) WHERE status = 'ACTIVE'
    (code)
  }
}

Table message {
  id bigint [pk, increment]
  chat_room_id bigint [not null, ref: > chat_room.id]
  sender_id bigint [ref: > users.id, note: 'SYSTEM 메시지는 NULL']
  type message_type [not null, default: 'TEXT']
  content text [not null]
  sent_at timestamptz [not null, default: `now()`]
  indexes {
    (chat_room_id, id) [note: '방별 최신순 커서 페이징']
  }
}


// ======================================================
// 활동 인증 / 캠퍼스 캔버스
// ======================================================

Table verification {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  uploader_id bigint [ref: > users.id]
  photo_url varchar(300) [not null]
  review_text varchar(200) [note: '업로더 후기']
  ai_status ai_status [not null, default: 'PENDING']
  ai_reason varchar(300) [note: 'AI 판정 근거']
  rejection_reason varchar(200) [note: '최종(사람) 반려 사유']
  canvas_pixel_x int
  canvas_pixel_y int
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
  indexes {
    (gathering_id, uploader_id) [unique]
    (ai_status)
    (canvas_pixel_x, canvas_pixel_y) [note: '캔버스 렌더링 조회']
  }
}
