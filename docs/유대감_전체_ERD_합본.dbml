// ======================================================
// 2gether / 유대감 — 전체 ERD 합본 (v3)
// DB: PostgreSQL / Spring Boot 3.5 + JPA(@Enumerated STRING)
//
// 구성: 학교·사용자·태그·가용일정·모임·AI/아이디어·활동인증
//       + 채팅(chat) + 알림(notification)  — 한 캔버스, 실제 관계선 연결
//
// 비고:
//  - 캠퍼스 비율 기능 제외 → users.campus 미사용(코드 User 엔티티와 일치)
//  - 태그는 단일 tags + type(코드 반영). gathering_tag/user_tag 는 통합 링크
//  - 부분 유니크(WHERE ...)·CHECK 는 DBML 문법에 없어 주석 표기(DDL에서 반영)
// ======================================================


// ─────────────────────────── Enum

Enum campus_type {
  HUMANITIES
  NATURAL
}

Enum day_of_week {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Enum availability_repeat_type {
  EVERY_WEEK
  ODD_WEEK
  EVEN_WEEK
}

Enum tag_type {
  HOBBY
  SKILL
}

Enum gathering_category {
  STUDY
  HOBBY
  HACKATHON
  PROJECT
  NETWORKING
}

Enum gathering_status {
  RECRUITING
  CONFIRMED
  COMPLETED
  CANCELED
}

Enum application_status {
  PENDING
  ACCEPTED
  REJECTED
}

Enum gathering_member_role {
  HOST
  MEMBER
}

Enum ai_status {
  PENDING
  APPROVED
  REJECTED
}

Enum chat_room_type {
  GROUP
  DIRECT
  QUICK_CONNECT
}

Enum chat_member_role {
  OWNER
  MEMBER
}

Enum message_type {
  TEXT
  IMAGE
  SYSTEM
  CARD
}

Enum quick_code_status {
  ACTIVE
  EXPIRED
  USED
}

Enum notification_type {
  GATHERING_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  GATHERING_CONFIRMED
  GATHERING_CANCELED
  CHAT_NOTICE
  SYSTEM
}


// ======================================================
// 학교 / 캠퍼스 / 단과대학 / 학과
// ======================================================

Table university {
  id bigint [pk, increment]
  name varchar(60) [not null, unique]
  email_domain varchar(60) [not null, unique, note: '예: mju.ac.kr']
}

Table college {
  id bigint [pk, increment]
  university_id bigint [not null, ref: > university.id]
  campus campus_type [not null]
  name varchar(60) [not null]
  indexes {
    (university_id, campus, name) [unique]
  }
}

Table department {
  id bigint [pk, increment]
  college_id bigint [not null, ref: > college.id]
  name varchar(60) [not null]
  indexes {
    (college_id, name) [unique]
  }
}


// ======================================================
// 사용자 / 인증 / 프로필
// ======================================================

Table users {
  id bigint [pk, increment]
  auth_user_id varchar(120) [not null, unique, note: 'Supabase Auth sub']
  department_id bigint [ref: > department.id, note: '온보딩 이전 NULL 허용']
  real_name varchar(30)
  nickname varchar(30) [unique]
  age smallint
  student_number varchar(15)
  preferred_region varchar(150)
  profile_image_url varchar(300)
  introduction varchar(200)
  school_email varchar(120) [unique]
  email_verified boolean [not null, default: false]
  profile_completed boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (department_id)
  }
}

Table email_verification {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  email varchar(120) [not null]
  verification_code varchar(10) [not null]
  expires_at timestamptz [not null]
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
  }
}


// ======================================================
// 태그 (단일 tags + type)
// ======================================================

Table tags {
  id bigint [pk, increment]
  name varchar(30) [not null]
  type tag_type [not null]
  indexes {
    (type, name) [unique]
    (type)
  }
}

Table user_tag {
  user_id bigint [not null, ref: > users.id]
  tag_id  bigint [not null, ref: > tags.id]
  indexes {
    (user_id, tag_id) [pk]
    (tag_id)
  }
}


// ======================================================
// 사용자 가용 일정
// ======================================================

Table availabilities {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  repeat_type availability_repeat_type [not null, default: 'EVERY_WEEK']
  day_of_week day_of_week [not null]
  start_time time [not null]
  end_time time [not null]
  indexes {
    (user_id, repeat_type, day_of_week, start_time, end_time) [unique]
    (user_id)
  }
}


// ======================================================
// 모임
// ======================================================

Table gathering {
  id bigint [pk, increment]
  host_id bigint [not null, ref: > users.id]
  title varchar(120) [not null]
  content text
  category gathering_category [not null]
  location varchar(150)
  max_members smallint [not null, default: 6, note: 'CHECK max_members >= 1']
  current_members smallint [not null, default: 1, note: '확정 인원 캐시']
  fusion_enabled boolean [not null, default: false]
  status gathering_status [not null, default: 'RECRUITING']
  recruit_start_at timestamptz [note: 'NULL이면 즉시 모집']
  recruit_end_at timestamptz [note: 'NULL이면 상시 모집']
  meet_at timestamptz
  confirmed_at timestamptz
  canceled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (status, category)
    (recruit_end_at)
    (host_id)
    (created_at)
  }
}

Table gathering_tag {
  gathering_id bigint [not null, ref: > gathering.id]
  tag_id bigint [not null, ref: > tags.id]
  indexes {
    (gathering_id, tag_id) [pk]
    (tag_id, gathering_id)
  }
}

Table gathering_image {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  image_url varchar(300) [not null]
  sort_order smallint [not null, default: 0]
  indexes {
    (gathering_id, sort_order) [unique]
  }
}

Table gathering_member {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  user_id bigint [not null, ref: > users.id]
  role gathering_member_role [not null, default: 'MEMBER']
  joined_at timestamptz [not null, default: `now()`]
  indexes {
    (gathering_id, user_id) [unique]
    (user_id)
  }
}

Table gathering_application {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  user_id bigint [not null, ref: > users.id]
  message varchar(300)
  status application_status [not null, default: 'PENDING']
  reject_reason varchar(200)
  applied_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz
  indexes {
    (gathering_id, user_id) [unique, note: '재신청 허용 시 부분 유니크(WHERE status IN (PENDING,ACCEPTED))로 전환']
    (user_id, status)
    (gathering_id, status)
  }
}


// ======================================================
// AI 추천 / 아이디어
// ======================================================

Table gathering_recommendation {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  gathering_id bigint [not null, ref: > gathering.id]
  round_no int [not null]
  reason varchar(300)
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, gathering_id, round_no) [unique]
    (user_id, round_no)
  }
}

Table idea {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  created_gathering_id bigint [ref: - gathering.id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
  }
}

Table idea_recommended_department {
  idea_id bigint [not null, ref: > idea.id]
  department_id bigint [not null, ref: > department.id]
  indexes {
    (idea_id, department_id) [pk]
  }
}


// ======================================================
// 채팅
// ======================================================

Table chat_room {
  id bigint [pk, increment]
  type chat_room_type [not null, note: 'GROUP / DIRECT / QUICK_CONNECT']
  gathering_id bigint [unique, ref: - gathering.id, note: '모임 자동 생성 방(1:1). DIRECT·QUICK_CONNECT는 NULL']
  title varchar(120) [note: 'GROUP=모임 제목 스냅샷, DIRECT는 앱에서 계산']
  last_message_id bigint [note: '비정규화 캐시(소프트 참조). 최근 방·미리보기']
  last_message_at timestamptz [note: '방 목록 최근순 정렬 기준']
  closed_at timestamptz [note: 'QUICK_CONNECT 종료 시각']
  created_at timestamptz [not null, default: `now()`]
}

Table chat_room_member {
  id bigint [pk, increment]
  chat_room_id bigint [not null, ref: > chat_room.id]
  user_id bigint [not null, ref: > users.id]
  role chat_member_role [not null, default: 'MEMBER', note: '공지/강퇴 권한']
  last_read_message_id bigint [note: '안읽음 수 = 이 값보다 큰 메시지 개수']
  notification_enabled boolean [not null, default: true]
  joined_at timestamptz [not null, default: `now()`]
  left_at timestamptz [note: '나가기(소프트). NULL이면 참여 중']
  indexes {
    (chat_room_id, user_id) [unique]
    (user_id)
  }
}

Table message {
  id bigint [pk, increment, note: '단조 증가 → 정렬/커서/읽음 비교']
  chat_room_id bigint [not null, ref: > chat_room.id]
  sender_id bigint [ref: > users.id, note: 'SYSTEM 메시지는 NULL']
  type message_type [not null, default: 'TEXT', note: 'TEXT/IMAGE/SYSTEM/CARD']
  content text [note: '텍스트/시스템 안내문. 이미지는 attachment']
  meta jsonb [note: 'SYSTEM 상세 · CARD 카드데이터({kind,refId,snapshot}) 흡수']
  deleted_at timestamptz [note: '소프트 삭제']
  client_message_id uuid [note: '소켓 재전송 멱등키']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (chat_room_id, id) [note: '방별 커서 페이징']
    (chat_room_id, client_message_id) [unique, note: '방 내 멱등 전송']
  }
}

Table message_attachment {
  id bigint [pk, increment]
  message_id bigint [not null, ref: > message.id]
  file_url varchar(300) [not null]
  thumbnail_url varchar(300)
  content_type varchar(100)
  size int
  width int
  height int
  sort_order smallint [not null, default: 0]
}

Table chat_notice {
  id bigint [pk, increment]
  chat_room_id bigint [not null, ref: > chat_room.id]
  message_id bigint [ref: > message.id, note: '고정한 메시지 참조(선택)']
  content varchar(500) [not null]
  created_by bigint [not null, ref: > users.id, note: 'role=OWNER']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (chat_room_id, is_active) [note: '활성 공지 유일성은 부분 유니크(WHERE is_active)로 DDL 보장']
  }
}

Table quick_connect_code {
  id bigint [pk, increment]
  chat_room_id bigint [not null, unique, ref: > chat_room.id]
  created_by bigint [ref: > users.id]
  code char(6) [not null]
  status quick_code_status [not null, default: 'ACTIVE']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (code) [note: '활성 코드 유일성은 부분 유니크(WHERE status=ACTIVE)로 DDL 보장']
  }
}


// ======================================================
// 알림 (독립 도메인)
// ======================================================

Table notification {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id, note: '알림 받는 사람']
  type notification_type [not null]
  title varchar(120) [not null, note: '발생 당시 텍스트(불변)']
  content varchar(300)
  meta jsonb [note: '이동 대상({gatheringId} / {roomId,messageId})']
  read_at timestamptz [note: 'NULL이면 안읽음 → 벨 배지']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, created_at)
    (user_id, read_at)
  }

  Note: '''
  이벤트성 알림함(벨). 채팅 메시지 배지는 여기 안 쌓고
  chat_room_member.last_read_message_id 로 계산(폭주 방지).
  각 도메인은 이벤트만 발행 → NotificationService 저장·전송(결합도 0).

  전송 경로:
   - 인앱: notification 저장 + WebSocket 푸시(기본)
   - 텔레그램: user_telegram 연결된 사용자에 한해 Telegram Bot API 발송(추가 채널)
  '''
}

Table user_telegram {
  user_id bigint [pk, ref: - users.id, note: '우리 서비스 사용자 : 텔레그램 = 1:1']
  telegram_chat_id bigint [not null, unique, note: '봇이 메시지 보낼 대상 chat id. 사용자가 봇 /start(연결) 후 저장']
  linked_at timestamptz [not null, default: `now()`]

  Note: '''
  유저 ↔ 텔레그램 연결 매핑(알림 발송용).
  텔레그램 봇은 사용자가 먼저 봇을 시작해야만 메시지 발송 가능하므로,
  연결한 사용자에게만 텔레그램 알림을 보낸다. 미연결 사용자는 인앱 알림만 수신.
  '''
}


// ======================================================
// 활동 인증 / 캠퍼스 캔버스
// ======================================================

Table verification {
  id bigint [pk, increment]
  gathering_id bigint [not null, ref: > gathering.id]
  uploader_id bigint [ref: > users.id]
  photo_url varchar(300) [not null]
  review_text varchar(200) [note: '업로더 후기']
  ai_status ai_status [not null, default: 'PENDING']
  ai_reason varchar(300) [note: 'AI 판정 근거']
  rejection_reason varchar(200) [note: '최종(사람) 반려 사유']
  canvas_pixel_x int
  canvas_pixel_y int
  created_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
  indexes {
    (gathering_id, uploader_id) [unique]
    (ai_status)
    (canvas_pixel_x, canvas_pixel_y)
  }
}
